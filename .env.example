# Kev decision server (local MLX). Started with:
#   uv run --extra serve python -m kev.serve --run jaredpalmer/kev-4b --port 8009
KEV_URL=http://127.0.0.1:8009

# Apple on-device model via `fm serve` (OpenAI compatible). Used for the commander briefing.
FM_URL=http://127.0.0.1:8080

# Where the Hono server listens. The Vite dev server proxies /api here.
PORT=8787

# SQLite file for plans, saved results and the decision cache.
DB_PATH=./data/gameday.db
