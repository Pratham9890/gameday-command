# Gameday Command — every environment variable the code reads, with its default.
# Copy to .env and change only what you need. The project runs with this file
# absent. Most values here are not secret, but GAMEDAY_ADMIN_PASSWORD is: keep
# real values out of the repository. Deployment modes: docs/v3/deploy.md.

# --- API server (server/src/index.ts) -------------------------------------
# Bind address. Loopback by default; a LAN address needs an account first.
HOST=127.0.0.1
# Port for the Hono API. `npm run dev` proxies /api here.
PORT=8787
# SQLite file holding the decision cache, saved plans and comparisons.
# Created on first run. Ignored by git, along with its -wal/-shm siblings.
DB_PATH=./data/gameday.db

# --- Kev-4B, the fan decision model (server/src/kev.ts) -------------------
# Kev is NOT a chat model: this is a TypeSafe-compatible POST /v1/systemone.
# With Kev down, every decision falls back to DecisionDefaults by design.
# Started with:
#   uv run --extra serve python -m kev.serve --run jaredpalmer/kev-4b --port 8009
KEV_URL=http://127.0.0.1:8009
# Model name as `GET /v1/models` reports it.
KEV_MODEL=kev-latest
# Deadline for the whole /decide call, shared across groups. Defaults to 75% of
# the contract's DECISION_TIMEOUT_MS (2000 ms), leaving the engine headroom to
# fall back inside its own 2 s pause.
KEV_TIMEOUT_MS=1500
# Groups asked at once. Kev serialises on one GPU, so raising this makes a cold
# cache WORSE — 16 answered one key where 4 answered five. Leave it at 4.
KEV_CONCURRENCY=4
# The background warmer has no commander waiting on it, so it gets a long
# deadline and finishes the keys the live call had to default.
KEV_WARM_TIMEOUT_MS=30000

# --- The commander briefing, via Apple's on-device model (server/src/fm.ts)
# `fm serve` is a real Chat Completions server. Always stream:false.
FM_URL=http://127.0.0.1:8080
FM_MODEL=system
FM_TIMEOUT_MS=20000

# --- Scripts ---------------------------------------------------------------
# npm run warm — which API server to warm the cache through, and the crowd size
# to warm it for. Keys depend on the fan mix, so warm at the size you demo at.
SERVER_URL=http://127.0.0.1:8787
WARM_FANS=100000
# npm run fetch-map — Overpass mirror for the OSM extract. Must run in a normal
# terminal: Overpass answers 406 to the Claude Code sandbox's egress proxy.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# --- Platform (server/src/platform/config.ts; docs/v3/deploy.md) -----------
# Public demo: no sign-in, a labelled demo user, synthetic data. VERCEL=1 implies it.
GAMEDAY_DEMO=
# TLS for HTTPS/WSS. Both or neither (mkcert works for a LAN, see deploy.md).
TLS_CERT_FILE=
TLS_KEY_FILE=
# Behind a TLS proxy: Secure cookies, client address from X-Forwarded-For.
GAMEDAY_SECURE_COOKIES=
GAMEDAY_TRUST_PROXY=
# Extra origins allowed to call the API and open the WebSocket (comma separated).
GAMEDAY_ORIGINS=
# Sessions: absolute hours (max 24) and idle minutes (max 60).
GAMEDAY_SESSION_HOURS=12
GAMEDAY_SESSION_IDLE_MINUTES=30
# Two-factor sign-in: required (default) or optional.
GAMEDAY_MFA=required
# 1 = the author of a plan version may not review or approve it.
GAMEDAY_TWO_PERSON=
# Password hashing cost (scrypt): log2(N), r, p. Recorded in every hash.
GAMEDAY_SCRYPT_LOG2N=15
GAMEDAY_SCRYPT_R=8
GAMEDAY_SCRYPT_P=3
# First-run administrator, used only while no account exists. SECRET: remove after first start.
GAMEDAY_ADMIN_USER=
GAMEDAY_ADMIN_PASSWORD=
GAMEDAY_ADMIN_PASSWORD_FILE=
GAMEDAY_ADMIN_NAME=
# Audit log: signing key file (default beside DB_PATH), earlier key ids still trusted, checkpoint spacing.
GAMEDAY_AUDIT_KEY_FILE=
GAMEDAY_AUDIT_TRUSTED_KEYS=
GAMEDAY_AUDIT_CHECKPOINT_EVERY=100
# Weather feed (NWS). Off until a contact (email or URL) is set; GAMEDAY_FEEDS=0 keeps it off.
GAMEDAY_FEED_CONTACT=
GAMEDAY_FEEDS=
GAMEDAY_VENUE_NAME=Ohio Stadium
GAMEDAY_VENUE_LAT=40.0016478
GAMEDAY_VENUE_LON=-83.0197398
# CAP draft <sender>.
GAMEDAY_CAP_SENDER=gameday-command.local
# Serve the built app from this server (default app/dist when it exists).
GAMEDAY_STATIC_DIR=
# Request body limits.
GAMEDAY_BODY_LIMIT_KB=1024
GAMEDAY_LARGE_BODY_LIMIT_MB=16
