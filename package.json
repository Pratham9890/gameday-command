{
  "name": "gameday-command",
  "private": true,
  "type": "module",
  "workspaces": [
    "engine",
    "world",
    "brain",
    "server",
    "app"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "npm run build --workspace @gameday/app",
    "dev": "npm run dev --workspace @gameday/app",
    "serve": "node --watch server/src/index.ts",
    "fetch-map": "node world/scripts/fetch-map.ts",
    "warm": "node scripts/warm-cache.ts",
    "seed:export": "node scripts/seed-export.ts",
    "admin:create": "node server/scripts/admin-create.ts",
    "backup": "node server/scripts/backup.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4",
    "vite": "^6.0.5"
  },
  "engines": {
    "node": ">=23.6"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "overrides": {
    "vite": "$vite"
  }
}
